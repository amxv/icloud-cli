                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "media_type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "bcc": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "body": {
          "type": "string"
        },
        "body_file": {
          "type": "string"
        },
        "cc": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "type": "string"
        },
        "headers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "html_body": {
          "type": "string"
        },
        "html_body_file": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "retry_of": {
          "type": "string"
        },
        "retry_unknown": {
          "type": "boolean"
        },
        "signature": {
          "type": "string"
        },
        "to": {
