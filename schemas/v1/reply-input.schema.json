            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "message_id": {
      "type": "string"
    },
    "replace_cc": {
      "type": "boolean"
    },
    "replace_to": {
      "type": "boolean"
    }
