{
  "name": "@amxv/icloud-cli",
  "version": "0.1.0",
  "description": "A local-first command-line client for iCloud services",
  "license": "Apache-2.0",
  "author": "amxv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amxv/icloud-cli.git"
  },
  "homepage": "https://icloud.ashray.xyz",
  "bugs": {
    "url": "https://github.com/amxv/icloud-cli/issues"
  },
  "bin": {
    "icloud": "bin/icloud.js"
  },
  "config": {
    "cliName": "icloud",
    "cliBinaryName": "icloud",
    "goModule": "github.com/amxv/icloud-cli"
  },
  "files": [
    "bin/icloud.js",
    "scripts/postinstall.js",
    "cmd",
    "internal",
    "go.mod",
    "go.sum",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CONTRIBUTORS.md",
    "Makefile",
    "project.config.json"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --check bin/icloud.js && node --check scripts/postinstall.js && node --test scripts/packaging.test.js",
    "lint": "npm run test",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "docs:check": "astro check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "icloud",
    "apple",
    "mail",
    "automation"
  ],
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.0.13",
    "astro": "^7.0.3",
    "typescript": "^5.9.2",
    "zuedocs": "0.1.25"
  }
}
