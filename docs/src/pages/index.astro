---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const featuredDocs = [
  "mail",
  "quickstart",
  "search-mail",
  "send-reply-and-forward",
  "organize-mail",
  "agent-guide"
].map((id) => docs.find((entry) => entry.id === id)).filter(Boolean);

const capabilities = [
  ["Read", "Sync your mailbox, open complete messages, browse conversations, save attachments"],
  ["Search", "Find mail locally in an instant or query iCloud directly when freshness matters"],
  ["Compose", "Draft, send, reply, reply-all, forward, use aliases, signatures, and S/MIME"],
  ["Organize", "Move, archive, flag, trash, manage folders, and apply reviewed bulk actions"]
];
---

<BaseLayout
  title={`${siteConfig.name} | iCloud Mail from the command line`}
  description="A fast, capable command-line client for reading, searching, composing, organizing, and automating iCloud Mail."
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <div class="icloud-home">
    <section class="icloud-hero shell">
      <div class="icloud-hero__intro">
        <p class="icloud-kicker">iCloud Mail, from the command line</p>
        <h1>Your inbox.<br /><em>In your shell.</em></h1>
        <p class="icloud-hero__lede">
          Search, read, draft, send, and organize iCloud Mail without leaving your terminal.
          Compact for humans, predictable for scripts, and easy for agents to use.
        </p>
        <div class="icloud-hero__actions">
          <a class="icloud-button icloud-button--primary" href="/docs/quickstart">Get started</a>
          <a class="icloud-button" href="/docs">
            Read the docs
            <svg class="icloud-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="icloud-command" aria-label="Install command">
        <span class="icloud-command__prompt" aria-hidden="true">$</span>
        <code id="icloud-install-command">npm install -g @amxv/icloud-cli</code>
        <span class="icloud-command__meta">npm · macOS · Linux · Windows</span>
        <button class="icloud-command__copy" type="button" data-copy-install aria-label="Copy install command">
          <svg class="icloud-icon icloud-command__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <svg class="icloud-icon icloud-command__check-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <div class="icloud-terminal-wrap" aria-label="Example icloud CLI session">
        <div class="icloud-terminal-shadow" aria-hidden="true"></div>
        <div class="icloud-terminal">
          <div class="icloud-terminal__bar">
            <div class="icloud-terminal__lights" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>icloud — zsh</span>
            <span>local-first</span>
          </div>
          <div class="icloud-terminal__body">
            <div class="icloud-terminal__line"><b>~</b><span>icloud mail threads list</span></div>
            <div class="icloud-terminal__output">
              <span class="dim">thread</span>
              <span><strong>thr_…</strong> subject="Project update"</span>
              <span>messages=3</span>
              <span>unread=1</span>
              <span>participants=you@example.com,alex@example.com</span>
            </div>

            <div class="icloud-terminal__line"><b>~</b><span>icloud mail search invoice --remote</span></div>
            <div class="icloud-terminal__output">
              <span class="dim">remote-hit</span>
              <span><strong>rem_…</strong> folder=INBOX</span>
              <span>from="Billing &lt;billing@example.com&gt;"</span>
              <span>subject="August invoice"</span>
            </div>

            <div class="icloud-terminal__line"><b>~</b><span>icloud mail reply msg_… --body-file reply.txt --dry-run</span></div>
            <div class="icloud-terminal__output icloud-terminal__output--last">
              <span class="dim">reply-preview</span>
              <span>smtp_contacted=false</span>
              <span>ready=true</span>
            </div>
            <div class="icloud-terminal__cursor" aria-hidden="true"><b>~</b><i></i></div>
          </div>
        </div>
      </div>
    </section>

    <section class="icloud-manifesto shell">
      <p class="icloud-section-index">01 / Mail, end to end</p>
      <div class="icloud-manifesto__copy">
        <h2>Everything you need to work through your mailbox.</h2>
        <p>
          Sync new mail, search across messages and attachments, read complete conversations,
          compose drafts, reply and forward, manage folders, and save files — all through one
          consistent <code>icloud mail</code> command tree.
        </p>
      </div>
    </section>

    <section class="icloud-capabilities shell">
      <div class="icloud-capabilities__head">
        <p class="icloud-section-index">02 / Everyday workflows</p>
        <h2>From a crowded inbox<br />to the next action.</h2>
      </div>
      <div class="icloud-capabilities__list">
        {capabilities.map(([label, description], index) => (
          <div class="icloud-capability">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{label}</h3>
            <p>{description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="icloud-automation shell">
      <div class="icloud-automation__copy">
        <p class="icloud-section-index">03 / Built for agents</p>
        <h2>Small outputs. Stable IDs. Deliberate writes.</h2>
        <p>
          Routine commands stay compact. JSON and JSONL are there when you need structure.
          Stable message and thread IDs, dry-run previews, and idempotent writes make multi-step
          mail workflows dependable in scripts and agents.
        </p>
        <a href="/docs/agent-guide">
          Read the agent guide
          <svg class="icloud-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="icloud-code-note" aria-label="Automation example">
        <div class="icloud-code-note__top"><span>request.json</span><span>v1</span></div>
        <pre><code>{`{
  "to": ["client@example.com"],
  "subject": "Project update",
  "body_file": "message.txt",
  "idempotency_key": "update-01"
}`}</code></pre>
        <div class="icloud-code-note__command">icloud mail send --input-json request.json --dry-run --json</div>
      </div>
    </section>

    <section class="icloud-docs shell">
      <div class="icloud-docs__heading">
        <div>
          <p class="icloud-section-index">04 / Documentation</p>
          <h2>Start with a command.<br />Go deeper when you need to.</h2>
        </div>
        <a href="/docs">
          Browse all docs
          <svg class="icloud-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="icloud-docs__list">
        {featuredDocs.map((entry, index) => entry && (
          <a class="icloud-doc-link" href={`/docs/${entry.id}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary ?? entry.data.description}</p>
            </div>
            <svg class="icloud-icon icloud-doc-link__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        ))}
      </div>
    </section>

    <section class="icloud-closing shell">
      <p>Your mailbox, from anywhere you have a shell.</p>
      <h2>Put iCloud Mail<br />on the command line.</h2>
      <div>
        <a class="icloud-button icloud-button--primary" href="/docs/quickstart">Install icloud</a>
        <a class="icloud-closing__github" href="https://github.com/amxv/icloud-cli">
          GitHub
          <svg class="icloud-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 7h10v10"></path>
            <path d="M7 17 17 7"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const installCommand = "npm install -g @amxv/icloud-cli";
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-install]");
  const copyLabel = copyButton?.querySelector<HTMLElement>("[data-copy-label]");

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(installCommand);
    } catch {
      return;
    }

    copyButton.dataset.copied = "true";
    copyButton.setAttribute("aria-label", "Install command copied");
    if (copyLabel) copyLabel.textContent = "Copied";

    window.setTimeout(() => {
      delete copyButton.dataset.copied;
      copyButton.setAttribute("aria-label", "Copy install command");
      if (copyLabel) copyLabel.textContent = "Copy";
    }, 1800);
  });
</script>

<style is:global>
  .icloud-home {
    --icloud-blue: #1b74e8;
    --icloud-blue-soft: #dcecff;
    --icloud-paper: #f7f7f4;
    --icloud-ink: #11110f;
    --icloud-rule: color-mix(in srgb, var(--ink) 14%, transparent);
    font-family: "Avenir Next", Avenir, "Helvetica Neue", sans-serif;
  }

  :root[data-theme="dark"] .icloud-home {
    --icloud-blue: #72aaff;
    --icloud-blue-soft: #172942;
    --icloud-paper: #121313;
    --icloud-ink: #f4f4ef;
    --icloud-rule: color-mix(in srgb, var(--ink) 17%, transparent);
  }

  .icloud-home h1,
  .icloud-home h2,
  .icloud-home h3 {
    color: var(--icloud-ink);
    font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .icloud-icon {
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icloud-kicker,
  .icloud-section-index {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .icloud-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(29rem, .92fr);
    grid-template-areas:
      "intro terminal"
      "command terminal";
    column-gap: clamp(3rem, 6vw, 7rem);
    align-items: start;
    padding-top: clamp(6rem, 9vw, 8.5rem);
    padding-bottom: clamp(6.5rem, 9vw, 9rem);
  }

  .icloud-hero::before {
    position: absolute;
    z-index: -1;
    top: -12rem;
    right: -20rem;
    width: 46rem;
    height: 46rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--icloud-blue) 16%, transparent) 0%, transparent 67%);
    content: "";
    pointer-events: none;
  }

  .icloud-hero__intro {
    grid-area: intro;
    position: relative;
    z-index: 2;
    max-width: 690px;
  }

  .icloud-hero h1 {
    max-width: 720px;
    margin-top: 1.8rem;
    font-size: clamp(4.35rem, 5.9vw, 6.25rem);
    line-height: 0.82;
  }

  .icloud-hero h1 em {
    color: var(--icloud-blue);
    font-weight: 400;
  }

  .icloud-hero__lede {
    max-width: 570px;
    margin-top: 2.8rem;
    color: color-mix(in srgb, var(--icloud-ink) 70%, transparent);
    font-size: clamp(1.05rem, 1.55vw, 1.28rem);
    line-height: 1.55;
    letter-spacing: -0.015em;
  }

  .icloud-hero__actions {
    display: flex;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .icloud-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 2.9rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--icloud-rule);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .icloud-button:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ink) 34%, transparent);
    text-decoration: none;
  }

  .icloud-button--primary {
    border-color: var(--icloud-ink);
    background: var(--icloud-ink);
    color: var(--bg);
  }

  .icloud-command {
    grid-area: command;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.9rem;
    width: min(620px, 100%);
    min-height: 3.6rem;
    margin-top: 2.6rem;
    padding: 0.65rem 0.75rem 0.65rem 1.1rem;
    border: 1px solid var(--icloud-rule);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    box-shadow: 0 12px 35px color-mix(in srgb, var(--ink) 5%, transparent);
    backdrop-filter: blur(12px);
  }

  .icloud-command__prompt { color: var(--icloud-blue); font-family: var(--font-mono); }
  .icloud-command code { color: var(--icloud-ink); font-family: var(--font-mono); font-size: 0.8rem; }
  .icloud-command__meta { color: var(--muted); font-size: 0.67rem; white-space: nowrap; }
  .icloud-command__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .38rem;
    min-height: 2.25rem;
    padding: .45rem .65rem;
    border: 1px solid var(--icloud-rule);
    border-radius: .62rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    color: var(--muted);
    cursor: pointer;
    font: 600 .66rem/1 var(--font-mono);
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
  }
  .icloud-command__copy:hover {
    border-color: color-mix(in srgb, var(--icloud-blue) 45%, var(--icloud-rule));
    color: var(--icloud-ink);
  }
  .icloud-command__copy:focus-visible {
    outline: 2px solid var(--icloud-blue);
    outline-offset: 2px;
  }
  .icloud-command__copy-icon,
  .icloud-command__check-icon { width: .9rem; height: .9rem; }
  .icloud-command__check-icon { display: none; }
  .icloud-command__copy[data-copied="true"] {
    border-color: color-mix(in srgb, #4f9d69 55%, var(--icloud-rule));
    background: color-mix(in srgb, #4f9d69 10%, var(--bg));
    color: #3d8657;
  }
  .icloud-command__copy[data-copied="true"] .icloud-command__copy-icon { display: none; }
  .icloud-command__copy[data-copied="true"] .icloud-command__check-icon { display: block; }

  .icloud-terminal-wrap {
    grid-area: terminal;
    position: relative;
    z-index: 1;
    width: min(100%, 42rem);
    margin-top: 2.8rem;
    justify-self: end;
    transform: rotate(1.15deg);
    transform-origin: 50% 50%;
  }

  .icloud-terminal-shadow {
    position: absolute;
    inset: 5% 4% -5%;
    z-index: -1;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--icloud-blue) 18%, transparent);
    filter: blur(42px);
  }

  .icloud-terminal {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.15rem;
    background: #111310;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
    color: #eceee8;
    font-family: "SFMono-Regular", Consolas, monospace;
  }

  .icloud-terminal__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 3rem;
    padding: 0 1rem;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: #181a17;
    color: #777b72;
    font-size: 0.64rem;
  }

  .icloud-terminal__bar > :last-child { justify-self: end; }
  .icloud-terminal__lights { display: flex; gap: .42rem; }
  .icloud-terminal__lights i { width: .62rem; height: .62rem; border-radius: 50%; background: #32352f; }
  .icloud-terminal__lights i:first-child { background: #d86657; }
  .icloud-terminal__lights i:nth-child(2) { background: #dda84d; }
  .icloud-terminal__lights i:nth-child(3) { background: #5aaa66; }

  .icloud-terminal__body {
    min-height: 27rem;
    padding: 1.45rem 1.55rem 1.8rem;
    font-size: clamp(0.66rem, .9vw, 0.76rem);
    line-height: 1.58;
  }

  .icloud-terminal__line span,
  .icloud-terminal__output span {
    overflow-wrap: anywhere;
  }

  .icloud-terminal__line { display: flex; gap: .7rem; margin-top: 1.3rem; color: #f5f5f0; }
  .icloud-terminal__line:first-child { margin-top: 0; }
  .icloud-terminal__line b, .icloud-terminal__cursor b { color: #72aaff; font-weight: 500; }
  .icloud-terminal__output { display: grid; margin: .7rem 0 0 1.25rem; color: #aeb2a8; }
  .icloud-terminal__output strong { color: #dcecff; font-weight: 500; }
  .icloud-terminal__output .dim { color: #64695f; }
  .icloud-terminal__output--last { color: #8cb993; }
  .icloud-terminal__cursor { display: flex; align-items: center; gap: .7rem; margin-top: 1.3rem; }
  .icloud-terminal__cursor i { width: .48rem; height: 1.05rem; background: #d5d8ce; animation: icloud-blink 1.15s steps(1) infinite; }

  @keyframes icloud-blink { 50% { opacity: 0; } }

  .icloud-manifesto,
  .icloud-capabilities,
  .icloud-automation,
  .icloud-docs,
  .icloud-closing {
    border-top: 1px solid var(--icloud-rule);
    padding-top: 2.2rem;
    padding-bottom: 8rem;
  }

  .icloud-manifesto {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 5rem;
  }

  .icloud-manifesto__copy { max-width: 760px; }
  .icloud-manifesto h2 { font-size: clamp(2.8rem, 5.6vw, 5.6rem); line-height: .98; }
  .icloud-manifesto__copy > p { max-width: 570px; margin-top: 2rem; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .icloud-manifesto__copy code { color: var(--icloud-ink); font-size: .9em; }

  .icloud-capabilities {
    display: grid;
    grid-template-columns: .88fr 1.35fr;
    gap: 6rem;
  }

  .icloud-capabilities__head h2 { margin-top: 2rem; font-size: clamp(2.7rem, 4.6vw, 4.8rem); line-height: .98; }
  .icloud-capabilities__list { border-top: 1px solid var(--icloud-rule); }
  .icloud-capability { display: grid; grid-template-columns: 2.4rem .55fr 1fr; gap: 1rem; align-items: baseline; padding: 1.55rem 0; border-bottom: 1px solid var(--icloud-rule); }
  .icloud-capability > span { color: var(--muted); font-family: var(--font-mono); font-size: .64rem; }
  .icloud-capability h3 { font-size: 1.55rem; }
  .icloud-capability p { color: var(--muted); font-size: .83rem; line-height: 1.5; }

  .icloud-automation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7rem;
    align-items: center;
  }

  .icloud-automation__copy h2 { max-width: 560px; margin-top: 2rem; font-size: clamp(2.8rem, 5vw, 5rem); line-height: .98; }
  .icloud-automation__copy > p { max-width: 520px; margin-top: 2rem; color: var(--muted); line-height: 1.7; }
  .icloud-automation__copy > a { display: inline-flex; align-items: center; gap: .5rem; margin-top: 2rem; color: var(--icloud-blue); font-size: .82rem; font-weight: 600; }

  .icloud-code-note {
    overflow: hidden;
    border: 1px solid var(--icloud-rule);
    border-radius: 1rem;
    background: var(--icloud-paper);
    box-shadow: 0 25px 60px color-mix(in srgb, var(--ink) 8%, transparent);
    transform: rotate(-1.5deg);
  }
  .icloud-code-note__top { display: flex; justify-content: space-between; padding: .85rem 1rem; border-bottom: 1px solid var(--icloud-rule); color: var(--muted); font-family: var(--font-mono); font-size: .64rem; }
  .icloud-code-note pre { margin: 0; padding: 2rem; background: transparent; color: var(--icloud-ink); font-size: .78rem; line-height: 1.75; white-space: pre-wrap; }
  .icloud-code-note__command { padding: 1rem; border-top: 1px solid var(--icloud-rule); color: var(--icloud-blue); font-family: var(--font-mono); font-size: .65rem; line-height: 1.5; }

  .icloud-docs__heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-bottom: 3.5rem; }
  .icloud-docs__heading h2 { margin-top: 2rem; font-size: clamp(2.8rem, 5vw, 5rem); line-height: .95; }
  .icloud-docs__heading > a { display: inline-flex; align-items: center; gap: .45rem; color: var(--icloud-blue); font-size: .8rem; font-weight: 600; white-space: nowrap; }
  .icloud-docs__list { border-top: 1px solid var(--icloud-rule); }
  .icloud-doc-link { display: grid; grid-template-columns: 4rem 1fr auto; gap: 2rem; align-items: center; padding: 1.6rem 0; border-bottom: 1px solid var(--icloud-rule); transition: padding 180ms ease; }
  .icloud-doc-link:hover { padding-right: .7rem; padding-left: .7rem; text-decoration: none; }
  .icloud-doc-link > span { color: var(--muted); font-family: var(--font-mono); font-size: .64rem; }
  .icloud-doc-link h3 { font-size: 1.65rem; }
