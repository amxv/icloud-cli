---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { docCategories, primaryNav, siteConfig } from "../../data/docs";

const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const grouped = docCategories.map((category) => ({
  category,
  entries: entries.filter((entry) => entry.data.category === category)
}));
---

<BaseLayout
  title={`${siteConfig.name} Docs`}
  description="Install icloud, configure credentials safely, validate iCloud Mail without sending, synchronize enabled folders, browse locally reconstructed RFC conversations, read complete messages explicitly, inspect health, and troubleshoot failures."
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="shell docs-index-hero">
    <p class="section-label">Documentation</p>
    <h1>Use <code>icloud</code> safely from a terminal, script, or agent.</h1>
    <p>
      Begin with installation and the quickstart, then choose the credential, validation, folder,
      sync/backfill/watch/repair, search, conversation, attachment, outbound/draft, location, local-state, automation, or generated command reference that fits the task.
    </p>
    <p>
      This product is intentionally scoped to iCloud Mail; it does not manage Contacts, Calendar, Drive, Notes, Photos, Find My, or a hosted mail service.
    </p>
  </section>
  <section class="shell docs-index">
    {grouped.map((group) => (
      <section class="docs-index__group">
        <div class="docs-index__group-head">
          <p class="section-label">{group.category}</p>
        </div>
        <div class="docs-index__cards">
          {group.entries.map((entry) => (
            <a class="docs-index__card" href={`/docs/${entry.id}`}>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <span>Open guide</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
