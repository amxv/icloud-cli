---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Compact by default",
    body: "Ordinary commands return bounded plain text without JSON scaffolding, ANSI decoration, or repeated labels."
  },
  {
    title: "Structured on request",
    body: "Commands that support machine output expose an explicit --json success or error envelope with a request ID."
  },
  {
    title: "Safe for automation",
    body: "Errors use stable exit classes, normal output stays on stdout, and diagnostics stay on stderr."
  },
  {
    title: "Self-documenting",
    body: "The live command tree generates shell completions and man pages, keeping reference output aligned with the binary."
  }
];

const workflows = [
  "Install the package or build from source, then verify the exact binary with icloud version.",
  "Inspect supported behavior with icloud capabilities before an agent chooses an output mode.",
  "Generate completions for Bash, Zsh, Fish, or PowerShell directly from the installed command tree.",
  "Generate a single root man page to stdout or the complete man-page tree into a directory."
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Local-first iCloud CLI</p>
      <h1>Control iCloud services with a command surface built for agents and humans.</h1>
      <p class="hero__lede">
        <code>icloud</code> uses compact plain text by default, stable structured output when requested,
        and one public executable across local builds, npm installs, and release assets.
      </p>
      <p class="hero__annotation">
        The current build establishes the command, output, help, completion, and man-page contract.
        It does not request credentials or contact iCloud yet.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Start with the quickstart</a>
        <a class="button button--ghost" href="/docs/command-reference">View commands</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">First session</p>
      <div class="hero__terminal">
        <span>$ icloud version</span>
        <span>version 0.1.0</span>
        <span>$ icloud capabilities</span>
        <span>capabilities command=icloud version=0.1.0 default_output=compact …</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">CLI contract</p>
      <h2>Small outputs for routine decisions, explicit expansion for structured consumers.</h2>
      <p>
        Redirecting output does not switch formats. An agent receives the same compact default as a
        terminal user unless it deliberately asks for JSON.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell split-section">
    <div>
      <p class="section-label">Available now</p>
      <h2>Inspect the build and generate local reference assets.</h2>
    </div>
    <div class="stack-list">
      {workflows.map((item) => (
        <article class="stack-list__item">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Install, inspect, automate, and troubleshoot the current command set.</h2>
      <p>
        Every page describes behavior present on the current branch and uses sanitized examples.
      </p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
