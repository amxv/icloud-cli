---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Compact by default",
    body: "Ordinary commands return bounded plain text without JSON scaffolding, ANSI decoration, or repeated labels."
  },
  {
    title: "Structured on request",
    body: "Commands that support machine output expose an explicit --json success or error envelope with a request ID."
  },
  {
    title: "Safe for automation",
    body: "Credentials stay out of argv, SQLite, JSON, and errors; failures use stable exits with stdout and stderr kept separate."
  },
  {
    title: "Self-documenting",
    body: "The live command tree generates shell completions and man pages, keeping reference output aligned with the binary."
  }
];

const workflows = [
  "Install the package or build from source, then verify the exact binary with icloud version.",
  "Add an offline iCloud Mail profile using the native keyring or an environment/file credential reference.",
  "Select, rename, default, rotate, or remove multiple profiles without exposing credential references or values.",
  "Validate direct-TLS IMAP and mandatory-STARTTLS SMTP safely, then inspect stored health with icloud doctor.",
  "Preview a normalized outbound request without network or state changes, then send text or HTML with explicit confirmation and idempotency.",
  "Discover nested and Unicode mailboxes, then synchronize bounded pages from enabled folders into private local state.",
  "Search synchronized mail offline, or query bounded iCloud metadata explicitly and hydrate only the remote messages you choose.",
  "Read compact sender, subject, state, attachment-count, and decoded-text previews offline without marking mail read.",
  "Browse stable locally reconstructed RFC conversations and follow durable aliases after late evidence merges provisional threads.",
  "Open one stable message ID for complete text, HTML, decoded headers, MIME details, or verified raw RFC822 export.",
  "Inspect supported behavior with icloud capabilities before an agent chooses an output mode.",
  "Generate completions for Bash, Zsh, Fish, or PowerShell directly from the installed command tree.",
  "Generate a single root man page to stdout or the complete man-page tree into a directory."
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Local-first iCloud CLI</p>
      <h1>Control iCloud services with a command surface built for agents and humans.</h1>
      <p class="hero__lede">
        <code>icloud</code> uses compact plain text by default, stable structured output when requested,
        and one public executable across local builds, npm installs, and release assets.
      </p>
      <p class="hero__annotation">
        The current build validates both iCloud Mail protocols, previews and sends deliberate text or HTML messages, replies to one exact synchronized message, discovers every folder, synchronizes
        bounded enabled-folder pages, starts Sent without crawling history, searches locally or through explicit bounded iCloud queries,
        hydrates selected remote messages without advancing sync, reconstructs RFC conversations locally,
        reads complete local messages explicitly, and keeps every mutation scoped and explicit.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Start with the quickstart</a>
        <a class="button button--ghost" href="/docs/command-reference">View commands</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">First session</p>
      <div class="hero__terminal">
        <span>$ icloud version</span>
        <span>version</span>
        <span>0.1.0</span>
        <span>$ icloud capabilities</span>
        <span>capabilities</span>
        <span>command=icloud</span>
        <span>version=0.1.0</span>
        <span>schema=13 …</span>
        <span>$ icloud account add --name Personal --email owner@icloud.com</span>
        <span>App-specific password:</span>
        <span>account-added</span>
        <span>acct_… status=pending_validation</span>
        <span>default=true</span>
        <span>credential=keyring</span>
        <span>$ icloud account test</span>
        <span>account-test</span>
        <span>acct_… status=connected</span>
        <span>imap=ok</span>
        <span>smtp=ok …</span>
        <span>$ icloud mail send --to client@example.com --subject Update --body-file message.txt --attach report.pdf --dry-run</span>
        <span>send-preview</span>
        <span>acct_… from="Personal &lt;owner@icloud.com&gt;"</span>
        <span>smtp_contacted=false</span>
        <span>$ icloud mail send --to client@example.com --subject Update --body-file message.txt --attach report.pdf --idempotency-key update-01 --yes</span>
        <span>mail-send</span>
        <span>send_… status=sent</span>
        <span>message_id=msg_…</span>
        <span>$ icloud mail folders status</span>
        <span>folder-status</span>
        <span>account=acct_…</span>
        <span>count=8</span>
        <span>enabled=2</span>
        <span>$ icloud mail sync</span>
        <span>mail-sync</span>
        <span>fld_… account=acct_…</span>
        <span>fetched=20</span>
        <span>last_uid=184</span>
        <span>$ icloud mail inbox</span>
        <span>message</span>
        <span>msg_… from=sender@example.com</span>
        <span>subject="Project update"</span>
        <span>$ icloud mail search invoice --remote</span>
        <span>remote-hit</span>
        <span>rem_… folder=INBOX</span>
        <span>subject="August invoice"</span>
        <span>$ icloud mail sync --hydrate rem_…</span>
        <span>mail-hydrate</span>
        <span>msg_… status=created</span>
        <span>$ icloud mail latest</span>
        <span>thread</span>
        <span>thr_… subject="Project update"</span>
        <span>messages=3</span>
        <span>reconstruction=local_rfc_graph</span>
        <span>$ icloud mail message show msg_… --full</span>
        <span>body</span>
        <span>Complete decoded text…</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">CLI contract</p>
      <h2>Small outputs for routine decisions, explicit expansion for structured consumers.</h2>
      <p>
        Redirecting output does not switch formats. An agent receives the same compact default as a
        terminal user unless it deliberately asks for JSON.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell split-section">
    <div>
      <p class="section-label">Available now</p>
      <h2>Configure private profiles, validate both mail protocols, send deliberately, synchronize or search safely, and choose exactly what remote content to cache and read.</h2>
    </div>
    <div class="stack-list">
      {workflows.map((item) => (
        <article class="stack-list__item">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Install, configure credentials, inspect, automate, and troubleshoot the current command set.</h2>
      <p>
        Every page describes behavior present on the current branch and uses sanitized examples.
      </p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
