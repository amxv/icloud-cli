.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-completion - Generate shell completion scripts


.SH SYNOPSIS
\fBicloud completion [flags]\fP


.SH DESCRIPTION
Generate shell completion scripts


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud completion bash > icloud.bash
  icloud completion zsh > _icloud
.EE


.SH SEE ALSO
\fBicloud(1)\fP, \fBicloud-completion-bash(1)\fP, \fBicloud-completion-fish(1)\fP, \fBicloud-completion-powershell(1)\fP, \fBicloud-completion-zsh(1)\fP
