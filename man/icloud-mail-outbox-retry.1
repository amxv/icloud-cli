.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-outbox-retry - Explicitly replay the exact reviewed raw message and private SMTP envelope


.SH SYNOPSIS
\fBicloud mail outbox retry  [flags]\fP


.SH DESCRIPTION
Explicitly replay the exact reviewed raw message and private SMTP envelope


.SH OPTIONS
\fB--dry-run\fP[=false]
	Review retry lifecycle metadata without contacting SMTP

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for retry

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive exact-message replay


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail outbox retry out_… --dry-run
  icloud mail outbox retry out_… --yes --json
.EE


.SH SEE ALSO
\fBicloud-mail-outbox(1)\fP
