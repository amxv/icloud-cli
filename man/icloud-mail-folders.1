.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-folders - Discover folders, inspect provider status, and choose sync policy


.SH SYNOPSIS
\fBicloud mail folders [flags]\fP


.SH DESCRIPTION
Discover folders, inspect provider status, and choose sync policy


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for folders


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail folders refresh
  icloud mail folders enable Receipts
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-folders-create(1)\fP, \fBicloud-mail-folders-delete(1)\fP, \fBicloud-mail-folders-disable(1)\fP, \fBicloud-mail-folders-enable(1)\fP, \fBicloud-mail-folders-list(1)\fP, \fBicloud-mail-folders-refresh(1)\fP, \fBicloud-mail-folders-rename(1)\fP, \fBicloud-mail-folders-role(1)\fP, \fBicloud-mail-folders-show(1)\fP, \fBicloud-mail-folders-status(1)\fP, \fBicloud-mail-folders-subscribe(1)\fP, \fBicloud-mail-folders-unsubscribe(1)\fP
