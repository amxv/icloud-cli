.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-sync - Fetch and atomically commit bounded pages from enabled mail folders


.SH SYNOPSIS
\fBicloud mail sync [flags]\fP


.SH DESCRIPTION
Fetch and atomically commit bounded pages from enabled mail folders


.SH OPTIONS
\fB--all-folders\fP[=false]
	Explicitly sync every current selectable folder, including locally disabled folders, with bounded recent bootstrap

.PP
\fB--continue-on-error\fP[=false]
	Continue independent hydration items or folders after an error; committed earlier work is never rolled back

.PP
\fB--folder\fP=""
	Sync one enabled folder by kind, ID, name, or wire name instead of all enabled folders

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB--hydrate\fP=[]
	Cache one or more comma-separated rem_… references without advancing folder checkpoints

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--jsonl\fP[=false]
	Emit typed per-folder or per-hydration-item JSONL events plus a completed event

.PP
\fB--limit\fP=20
	Maximum messages to fetch and commit per folder (1-100)

.PP
\fB--reconcile-outbound\fP[=false]
	Sync Sent and reconcile recent sent/unknown attempts by exact Message-ID evidence


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail sync
  icloud mail sync --folder sent
  icloud mail sync --hydrate rem_…
  icloud mail sync --all-folders --continue-on-error --jsonl
  icloud mail sync --limit 50 --json
  icloud mail sync status --folder sent
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-sync-backfill(1)\fP, \fBicloud-mail-sync-checkpoints(1)\fP, \fBicloud-mail-sync-rebaseline(1)\fP, \fBicloud-mail-sync-repair(1)\fP, \fBicloud-mail-sync-status(1)\fP
