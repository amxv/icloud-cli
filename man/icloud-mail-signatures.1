.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-signatures - Manage local per-identity compose signatures


.SH SYNOPSIS
\fBicloud mail signatures [flags]\fP


.SH DESCRIPTION
Manage local per-identity compose signatures


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for signatures


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-signatures-create(1)\fP, \fBicloud-mail-signatures-default(1)\fP, \fBicloud-mail-signatures-delete(1)\fP, \fBicloud-mail-signatures-list(1)\fP, \fBicloud-mail-signatures-show(1)\fP, \fBicloud-mail-signatures-update(1)\fP
