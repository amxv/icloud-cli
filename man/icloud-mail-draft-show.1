.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft-show - Show a draft with bounded default content or an explicit body/raw expansion


.SH SYNOPSIS
\fBicloud mail draft show  [flags]\fP


.SH DESCRIPTION
Show a draft with bounded default content or an explicit body/raw expansion


.SH OPTIONS
\fB--body-only\fP[=false]
	Write only the selected body representation

.PP
\fB--format\fP="compact"
	Content format: compact, text, html, or raw

.PP
\fB--full\fP[=false]
	Include the complete decoded text body

.PP
\fB--headers\fP[=false]
	Include decoded headers (BCC remains omitted)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--verbose\fP[=false]
	Include provider recovery IDs and MIME detail


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH SEE ALSO
\fBicloud-mail-draft(1)\fP
