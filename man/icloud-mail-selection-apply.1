.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-selection-apply - Read or mutate exactly the frozen MailSelection target set


.SH SYNOPSIS
\fBicloud mail selection apply  [flags]\fP


.SH DESCRIPTION
Read or mutate exactly the frozen MailSelection target set


.SH OPTIONS
\fB--action\fP=""
	Reviewed action to apply to the frozen target set

.PP
\fB--dry-run\fP[=false]
	Review exact frozen targets/action and emit the required request hash without provider contact

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for apply

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--jsonl\fP[=false]
	Emit ordered per-item and completed JSONL events for writes

.PP
\fB--mode\fP="atomic"
	Failure mode: validate then fail fast, or continue-on-error

.PP
\fB--request-hash\fP=""
	Exact hash emitted by the matching --dry-run review

.PP
\fB--to\fP=""
	Destination folder for move, copy, or restore; semantic actions resolve their normal destination

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive location-changing selection apply


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail selection apply sel_… --action read --json
  icloud mail selection apply sel_… --action mark-read --dry-run
  icloud mail selection apply sel_… --action archive --dry-run
  icloud mail selection apply sel_… --action archive --request-hash <hash> --yes --jsonl
.EE


.SH SEE ALSO
\fBicloud-mail-selection(1)\fP
