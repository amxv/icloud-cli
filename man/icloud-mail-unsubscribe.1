.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-unsubscribe - Safely execute a standards-based mailing-list unsubscribe action


.SH SYNOPSIS
\fBicloud mail unsubscribe  [flags]\fP


.SH DESCRIPTION
Safely execute a standards-based mailing-list unsubscribe action


.SH OPTIONS
\fB--dry-run\fP[=false]
	Review only local sanitized unsubscribe capability; do not verify DKIM, POST, or send mail

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for unsubscribe

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON envelope

.PP
\fB--method\fP=""
	Safe method ID from dry-run, for example one-click or mailto:2

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive unsubscribe action


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail unsubscribe msg_… --dry-run
  icloud mail unsubscribe msg_… --yes
  icloud mail unsubscribe msg_… --method mailto:2 --yes --json
  icloud mail unsubscribe --input-json request.json --dry-run --json
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP
