.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft-create - Create one local draft without contacting iCloud


.SH SYNOPSIS
\fBicloud mail draft create [flags]\fP


.SH DESCRIPTION
Create one local draft without contacting iCloud


.SH OPTIONS
\fB--attach\fP=[]
	Regular file path to attach; repeat as needed

.PP
\fB--attach-cid\fP=[]
	Set one attachment Content-ID as path=local@domain

.PP
\fB--attach-disposition\fP=[]
	Set one attachment disposition as path=attachment or path=inline

.PP
\fB--attach-name\fP=[]
	Override one attachment filename as path=filename

.PP
\fB--attach-type\fP=[]
	Override one attachment media type as path=type/subtype

.PP
\fB--bcc\fP=[]
	Bcc recipient preserved in the saved draft; hidden from default output

.PP
\fB--body\fP=""
	Inline text body; may be empty

.PP
\fB--body-file\fP=""
	Text body file path, or - for stdin

.PP
\fB--cc\fP=[]
	Cc recipient address; repeat as needed

.PP
\fB--from\fP=""
	Sender identity by stable mid_… ID or configured address (defaults to the account's local default identity)

.PP
\fB--header\fP=[]
	Safe custom header as Name: Value; repeat as needed

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--html-body\fP=""
	Inline HTML body

.PP
\fB--html-body-file\fP=""
	HTML body file path, or - for stdin

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--reply-to\fP=""
	Optional Reply-To address

.PP
\fB--signature\fP=""
	Override the configured new-message signature with one sig_… ID or none

.PP
\fB--subject\fP=""
	Draft subject; may be empty

.PP
\fB--to\fP=[]
	Recipient address; repeat or provide a comma-separated address list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail draft create --subject 'Idea' --body 'Incomplete is okay'
  icloud mail draft update drf_… --to client@example.com --subject 'Ready soon' --body-file draft.txt
.EE


.SH SEE ALSO
\fBicloud-mail-draft(1)\fP
