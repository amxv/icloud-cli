.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-selection-show - Show immutable reviewed MailSelection membership without message content


.SH SYNOPSIS
\fBicloud mail selection show  [flags]\fP


.SH DESCRIPTION
Show immutable reviewed MailSelection membership without message content


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--input-json\fP=""
	Read one strict JSON read request from a file, or - for stdin; cannot be mixed with equivalent read flags or positional read arguments

.PP
\fB--json\fP[=false]
	Emit selection metadata and stable target evidence as JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail selection show sel_…
  icloud mail selection show sel_… --json
.EE


.SH SEE ALSO
\fBicloud-mail-selection(1)\fP
