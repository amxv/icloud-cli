.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-status - Show bounded local mail operation status


.SH SYNOPSIS
\fBicloud mail status [flags]\fP


.SH DESCRIPTION
Show bounded local mail operation status


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum attempts to return (1-100)

.PP
\fB--mutations\fP[=false]
	List recent message location mutation intents and outcomes

.PP
\fB--outbound\fP[=false]
	List recent outbound send attempts


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail status --outbound
  icloud mail status --mutations
  icloud mail status --mutations --limit 50 --json
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP
