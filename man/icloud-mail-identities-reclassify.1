.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-identities-reclassify - Advance bounded local historical direction repair for newly recognized self addresses


.SH SYNOPSIS
\fBicloud mail identities reclassify [flags]\fP


.SH DESCRIPTION
Advance bounded local historical direction repair for newly recognized self addresses


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for reclassify

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum historical messages to promote in this pass (1-100)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail identities reclassify
  icloud mail identities reclassify --limit 100 --json
.EE


.SH SEE ALSO
\fBicloud-mail-identities(1)\fP
