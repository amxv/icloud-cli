.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-operations-mutations - Inspect message location mutation history


.SH SYNOPSIS
\fBicloud mail operations mutations [flags]\fP


.SH DESCRIPTION
Inspect message location mutation history


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for mutations


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail operations mutations list
  icloud mail operations mutations show mut_…
.EE


.SH SEE ALSO
\fBicloud-mail-operations(1)\fP, \fBicloud-mail-operations-mutations-list(1)\fP, \fBicloud-mail-operations-mutations-show(1)\fP
