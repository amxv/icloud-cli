.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-mailbox-import - Resume a bounded mboxrd import through exact single-message APPEND recovery


.SH SYNOPSIS
\fBicloud mail mailbox import  [flags]\fP


.SH DESCRIPTION
Resume a bounded mboxrd import through exact single-message APPEND recovery


.SH OPTIONS
\fB--dry-run\fP[=false]
	Fingerprint and validate the next archive record locally without creating a job or contacting IMAP

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--jsonl\fP[=false]
	Emit ordered record results plus one terminal completed event

.PP
\fB--max-messages\fP=100
	Maximum archive records to attempt in this invocation

.PP
\fB--mode\fP="atomic"
	Failure mode for this bounded pass: fail fast or continue-on-error

.PP
\fB--to\fP=""
	Current selectable destination folder kind, ID, name, or wire name

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive provider import


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail mailbox import archive.mbox --to inbox --dry-run
  icloud mail mailbox import archive.mbox --to Archive --max-messages 100 --yes
  icloud mail mailbox import archive.mbox --to inbox --mode continue-on-error --yes --jsonl
  icloud mail mailbox import --input-json request.json --yes --json
.EE


.SH SEE ALSO
\fBicloud-mail-mailbox(1)\fP
