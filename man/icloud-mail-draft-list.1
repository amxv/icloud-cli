.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft-list - List local and provider-synchronized drafts


.SH SYNOPSIS
\fBicloud mail draft list [flags]\fP


.SH DESCRIPTION
List local and provider-synchronized drafts


.SH OPTIONS
\fB--cursor\fP=""
	Opaque cursor from a previous draft list page

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum drafts to return (1-100)

.PP
\fB--verbose\fP[=false]
	Include provider recovery IDs and timestamps


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail draft list
  icloud mail draft list --limit 50 --json
  icloud mail draft list --cursor '<opaque-cursor>'
.EE


.SH SEE ALSO
\fBicloud-mail-draft(1)\fP
