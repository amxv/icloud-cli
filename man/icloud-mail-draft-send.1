.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft-send - Preview or send one draft through the normal idempotent outbound path


.SH SYNOPSIS
\fBicloud mail draft send  [flags]\fP


.SH DESCRIPTION
Preview or send one draft through the normal idempotent outbound path


.SH OPTIONS
\fB--dry-run\fP[=false]
	Preview the normalized send without contacting SMTP or deleting the draft

.PP
\fB--format\fP=""
	With --dry-run, output text, html, or raw preview content

.PP
\fB--headers\fP[=false]
	With --dry-run, print normalized safe headers

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for send

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--verbose\fP[=false]
	With --dry-run, include normalized header detail

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive send


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH SEE ALSO
\fBicloud-mail-draft(1)\fP
