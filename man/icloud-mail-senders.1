.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-senders - Manage local VIP and blocked sender preferences


.SH SYNOPSIS
\fBicloud mail senders [flags]\fP


.SH DESCRIPTION
Manage local VIP and blocked sender preferences


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for senders


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-senders-block(1)\fP, \fBicloud-mail-senders-list(1)\fP, \fBicloud-mail-senders-show(1)\fP, \fBicloud-mail-senders-unblock(1)\fP, \fBicloud-mail-senders-unvip(1)\fP, \fBicloud-mail-senders-vip(1)\fP
