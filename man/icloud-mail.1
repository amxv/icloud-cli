.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail - Send, reply, forward, inspect, synchronize, and change exact iCloud Mail locations


.SH SYNOPSIS
\fBicloud mail [flags]\fP


.SH DESCRIPTION
Send, reply, forward, inspect, synchronize, and change exact iCloud Mail locations


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for mail


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail send --to client@example.com --subject Update --body-file message.txt --dry-run
  icloud mail reply msg_… --body-file reply.txt --dry-run
  icloud mail forward msg_… --to teammate@example.com --dry-run
  icloud mail move msg_… --from inbox --to Projects --dry-run
  icloud mail sync
  icloud mail messages list
  icloud mail message show msg_…
  icloud mail folders refresh
.EE


