.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-account-credential - Inspect or change account credential metadata


.SH SYNOPSIS
\fBicloud account credential [flags]\fP


.SH DESCRIPTION
Inspect or change account credential metadata


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for credential


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud account credential show Personal
  icloud account credential replace Personal --password-stdin
.EE


.SH SEE ALSO
\fBicloud-account(1)\fP, \fBicloud-account-credential-delete(1)\fP, \fBicloud-account-credential-replace(1)\fP, \fBicloud-account-credential-show(1)\fP
