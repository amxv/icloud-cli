.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-threads - List, read, and change locally reconstructed conversations


.SH SYNOPSIS
\fBicloud mail threads [flags]\fP


.SH DESCRIPTION
List, read, and change locally reconstructed conversations


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for threads


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail threads list
  icloud mail threads show thr_…
  icloud mail threads mark-read thr_… --folder inbox
  icloud mail threads archive thr_… --from inbox --dry-run
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-threads-archive(1)\fP, \fBicloud-mail-threads-copy(1)\fP, \fBicloud-mail-threads-delete(1)\fP, \fBicloud-mail-threads-flag(1)\fP, \fBicloud-mail-threads-junk(1)\fP, \fBicloud-mail-threads-list(1)\fP, \fBicloud-mail-threads-mark-read(1)\fP, \fBicloud-mail-threads-mark-unread(1)\fP, \fBicloud-mail-threads-move(1)\fP, \fBicloud-mail-threads-not-junk(1)\fP, \fBicloud-mail-threads-restore(1)\fP, \fBicloud-mail-threads-show(1)\fP, \fBicloud-mail-threads-trash(1)\fP, \fBicloud-mail-threads-unarchive(1)\fP, \fBicloud-mail-threads-unflag(1)\fP
