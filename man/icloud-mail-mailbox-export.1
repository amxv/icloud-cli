.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-mailbox-export - Stream one synchronized mailbox as mboxrd without contacting iCloud


.SH SYNOPSIS
\fBicloud mail mailbox export  [flags]\fP


.SH DESCRIPTION
Stream one synchronized mailbox as mboxrd without contacting iCloud


.SH OPTIONS
\fB--force\fP[=false]
	Replace an existing regular archive file

.PP
\fB--format\fP="mboxrd"
	Mailbox archive format; currently mboxrd

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for export

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON summary when output is a file

.PP
\fB--output\fP=""
	Archive destination path, or - for native stdout


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail mailbox export inbox --format mboxrd --output inbox.mbox
  icloud mail mailbox export Archive --output - > archive.mbox
  icloud mail mailbox export --input-json request.json --json
.EE


.SH SEE ALSO
\fBicloud-mail-mailbox(1)\fP
