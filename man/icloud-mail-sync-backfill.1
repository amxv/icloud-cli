.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-sync-backfill - Resume one bounded historical page without moving the new-mail frontier


.SH SYNOPSIS
\fBicloud mail sync backfill [flags]\fP


.SH DESCRIPTION
Resume one bounded historical page without moving the new-mail frontier


.SH OPTIONS
\fB--after\fP=""
	Include messages on or after this UTC date (YYYY-MM-DD)

.PP
\fB--before\fP=""
	Include messages before this UTC date (YYYY-MM-DD)

.PP
\fB--folder\fP="inbox"
	Folder kind, ID, name, or wire name

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for backfill

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--jsonl\fP[=false]
	Emit one event per committed historical page plus a completed event

.PP
\fB--limit\fP=20
	Maximum historical messages to fetch and commit in this page (1-100)

.PP
\fB--max-messages\fP=1000
	Maximum fetched historical messages for --until-complete (1-10000)

.PP
\fB--max-pages\fP=20
	Maximum committed backfill pages for --until-complete (1-1000)

.PP
\fB--until-complete\fP[=false]
	Repeat bounded historical pages until complete or a global drain ceiling is reached


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail sync backfill --folder inbox
  icloud mail sync backfill --folder Receipts --after 2025-01-01 --before 2026-01-01 --limit 50
  icloud mail sync backfill --folder fld_… --json
.EE


.SH SEE ALSO
\fBicloud-mail-sync(1)\fP
