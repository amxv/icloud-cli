.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-outbox-list - List bounded local safe-retry Outbox items without exposing message payloads or recipients


.SH SYNOPSIS
\fBicloud mail outbox list [flags]\fP


.SH DESCRIPTION
List bounded local safe-retry Outbox items without exposing message payloads or recipients


.SH OPTIONS
\fB--cursor\fP=""
	Continue from a next_cursor returned for the same account

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--input-json\fP=""
	Read one strict JSON read request from a file, or - for stdin; cannot be mixed with equivalent read flags or positional read arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum Outbox items to return (1-100)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail outbox list
  icloud mail outbox list --limit 50 --cursor obcur_… --json
  icloud mail outbox list --input-json request.json --json
.EE


.SH SEE ALSO
\fBicloud-mail-outbox(1)\fP
