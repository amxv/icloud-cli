.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-message-import - Append one validated RFC message and ingest the exact provider copy


.SH SYNOPSIS
\fBicloud mail message import  [flags]\fP


.SH DESCRIPTION
Append one validated RFC message and ingest the exact provider copy


.SH OPTIONS
\fB--dry-run\fP[=false]
	Validate and review the exact source locally without creating import intent or contacting IMAP

.PP
\fB--flag\fP=[]
	Initial provider flag: seen, flagged, or answered; repeat as needed

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB--idempotency-key\fP=""
	Reuse the original operation when the same normalized request and idempotency key are repeated

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--internal-date\fP=""
	Provider INTERNALDATE as RFC3339; defaults to the message Date header or current time

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--to\fP=""
	Current selectable destination folder kind, ID, name, or wire name

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive provider APPEND


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail message import message.eml --to inbox --dry-run
  icloud mail message import message.eml --to Archive --flag seen --idempotency-key import-01 --yes
  icloud mail message import --input-json request.json --dry-run --json
.EE


.SH SEE ALSO
\fBicloud-mail-message(1)\fP
