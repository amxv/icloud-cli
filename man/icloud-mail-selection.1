.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-selection - Create and apply short-lived immutable reviewed mail target sets


.SH SYNOPSIS
\fBicloud mail selection [flags]\fP


.SH DESCRIPTION
Create and apply short-lived immutable reviewed mail target sets


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for selection


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail selection create msg_… msg_… --scope-folder inbox
  icloud mail selection create --search --unread --folder inbox --scope-folder inbox
  icloud mail selection show sel_…
  icloud mail selection apply sel_… --action archive --dry-run
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-selection-apply(1)\fP, \fBicloud-mail-selection-create(1)\fP, \fBicloud-mail-selection-delete(1)\fP, \fBicloud-mail-selection-show(1)\fP
