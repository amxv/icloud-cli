.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud - Control iCloud Mail from the command line


.SH SYNOPSIS
\fBicloud [flags]\fP


.SH DESCRIPTION
icloud is a local-first iCloud Mail CLI for account setup, validation, folder and synchronization workflows, offline and bounded remote search, complete message and attachment reads, drafts, deliberate send/reply/forward operations, message-state and location changes, recovery diagnostics, automation-safe JSON/JSONL, shell completion, and man-page generation.


.SH OPTIONS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for icloud

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for icloud


.SH EXAMPLE
.EX
  icloud account add --name Personal --email owner@icloud.com --password-stdin
  icloud account test
  icloud mail send --to client@example.com --subject Update --body-file message.txt --dry-run
  icloud mail reply msg_… --body-file reply.txt --dry-run
  icloud mail forward msg_… --to teammate@example.com --dry-run
  icloud mail move msg_… --from inbox --to Projects --dry-run
  icloud mail sync
  icloud mail message show msg_…
  icloud doctor
.EE


.SH SEE ALSO
\fBicloud-account(1)\fP, \fBicloud-capabilities(1)\fP, \fBicloud-completion(1)\fP, \fBicloud-doctor(1)\fP, \fBicloud-mail(1)\fP, \fBicloud-man(1)\fP, \fBicloud-version(1)\fP
