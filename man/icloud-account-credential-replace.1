.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-account-credential-replace - Replace an account credential and return it to pending validation


.SH SYNOPSIS
\fBicloud account credential replace  [flags]\fP


.SH DESCRIPTION
Replace an account credential and return it to pending validation


.SH OPTIONS
\fB--credential-env\fP=""
	Persist an environment-variable credential reference

.PP
\fB--credential-file\fP=""
	Persist a credential-file reference

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for replace

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--password-stdin\fP[=false]
	Read an app-specific password from stdin and store it in the native keyring


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  printf '%s\\n' "$NEW_PASSWORD" | icloud account credential replace Personal --password-stdin
.EE


.SH SEE ALSO
\fBicloud-account-credential(1)\fP
