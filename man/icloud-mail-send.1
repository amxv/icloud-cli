.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-send - Preview or send text, HTML, and attachments safely and idempotently


.SH SYNOPSIS
\fBicloud mail send [flags]\fP


.SH DESCRIPTION
Preview or send text, HTML, and attachments safely and idempotently


.SH OPTIONS
\fB--attach\fP=[]
	Regular file path to attach; repeat as needed

.PP
\fB--attach-cid\fP=[]
	Set one attachment Content-ID as path=local@domain; repeat as needed

.PP
\fB--attach-disposition\fP=[]
	Set one attachment disposition as path=attachment or path=inline; repeat as needed

.PP
\fB--attach-name\fP=[]
	Override one attachment filename as path=filename; repeat as needed

.PP
\fB--attach-type\fP=[]
	Override one attachment media type as path=type/subtype; repeat as needed

.PP
\fB--bcc\fP=[]
	Bcc envelope recipient; omitted from message headers

.PP
\fB--body\fP=""
	Inline text body

.PP
\fB--body-file\fP=""
	Text body file path, or - for stdin

.PP
\fB--cc\fP=[]
	Cc recipient address; repeat as needed

.PP
\fB--dry-run\fP[=false]
	Preview the normalized message without creating an attempt or contacting SMTP

.PP
\fB--format\fP=""
	With --dry-run, output text, html, or raw preview content

.PP
\fB--from\fP=""
	Sender identity by stable mid_… ID or configured address (defaults to the account's local default identity)

.PP
\fB--header\fP=[]
	Safe custom header as Name: Value; repeat as needed

.PP
\fB--headers\fP[=false]
	With --dry-run, print normalized safe header fields (Bcc remains omitted)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for send

.PP
\fB--html-body\fP=""
	Inline HTML body

.PP
\fB--html-body-file\fP=""
	HTML body file path, or - for stdin

.PP
\fB--idempotency-key\fP=""
	Reuse the original operation when the same normalized request and idempotency key are repeated

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--reply-to\fP=""
	Optional Reply-To address

.PP
\fB--retry-of\fP=""
	Link an explicit retry to one failed or unknown send_… attempt

.PP
\fB--retry-unknown\fP[=false]
	Authorize one duplicate-risk retry of an unknown attempt; requires --retry-of and --yes

.PP
\fB--signature\fP=""
	Override the configured signature with one sig_… ID or none

.PP
\fB--smime\fP=""
	S/MIME protection: none, sign, encrypt, or sign-encrypt

.PP
\fB--subject\fP=""
	Message subject

.PP
\fB--to\fP=[]
	Recipient address; repeat or provide a comma-separated address list

.PP
\fB--verbose\fP[=false]
	With --dry-run, include normalized custom-header detail and HTML byte count

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive send


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail send --to client@example.com --subject 'Update' --body-file message.txt --dry-run
  icloud mail send --to 'Client <client@example.com>' --subject 'Update' --body 'Hello' --attach report.pdf --yes --idempotency-key send-01
  icloud mail send --to client@example.com --subject 'Update' --body-file - --yes --json
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP
