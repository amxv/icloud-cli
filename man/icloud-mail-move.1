.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-move - Move one exact current message location


.SH SYNOPSIS
\fBicloud mail move  [flags]\fP


.SH DESCRIPTION
Move one exact current message location


.SH OPTIONS
\fB--dry-run\fP[=false]
	Preview the exact location change without creating intent or contacting IMAP

.PP
\fB--from\fP=""
	Select one exact current source folder by ID, name, wire name, or kind

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for move

.PP
\fB--idempotency-key\fP=""
	Reuse the original operation when the same normalized request and idempotency key are repeated

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--to\fP=""
	Select one current destination folder by ID, name, wire name, or kind

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive location change


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail move msg_… --from inbox --to Projects --dry-run
  icloud mail move msg_… --from inbox --to Projects --idempotency-key move-01 --yes
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP
