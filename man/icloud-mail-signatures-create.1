.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-signatures-create - Create one account-local signature


.SH SYNOPSIS
\fBicloud mail signatures create [flags]\fP


.SH DESCRIPTION
Create one account-local signature


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--html\fP=""
	Optional inline HTML signature body

.PP
\fB--html-file\fP=""
	Optional HTML signature file path, or - for stdin

.PP
\fB--identity\fP=""
	Optionally bind this signature to one mail identity (use none on update to clear the binding)

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--text\fP=""
	Inline plain-text signature body

.PP
\fB--text-file\fP=""
	Plain-text signature file path, or - for stdin


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail signatures create --text-file signature.txt
  icloud mail signatures create --identity mid_… --text 'Thanks,
Alex' --json
.EE


.SH SEE ALSO
\fBicloud-mail-signatures(1)\fP
