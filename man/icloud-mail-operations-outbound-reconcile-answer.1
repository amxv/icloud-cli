.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-operations-outbound-reconcile-answer - Retry only the provider Answered-state write for one proven sent reply


.SH SYNOPSIS
\fBicloud mail operations outbound reconcile-answer  [flags]\fP


.SH DESCRIPTION
Retry only the provider Answered-state write for one proven sent reply


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for reconcile-answer

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail operations outbound reconcile-answer send_…
  icloud mail operations outbound reconcile-answer send_… --json
.EE


.SH SEE ALSO
\fBicloud-mail-operations-outbound(1)\fP
