.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-account-test - Validate credentials against iCloud IMAP and SMTP without sending mail


.SH SYNOPSIS
\fBicloud account test [selector] [flags]\fP


.SH DESCRIPTION
Validate credentials against iCloud IMAP and SMTP without sending mail


.SH OPTIONS
\fB--all\fP[=false]
	Validate every configured account (maximum 100)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for test

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--verbose\fP[=false]
	Include bounded protocol capability summaries


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud account test
  icloud account test Personal
  icloud account test --all --json
.EE


.SH SEE ALSO
\fBicloud-account(1)\fP
