.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-settings-show - Show local defaults, bindings, preferences, and provider compatibility without network access


.SH SYNOPSIS
\fBicloud mail settings show [flags]\fP


.SH DESCRIPTION
Show local defaults, bindings, preferences, and provider compatibility without network access


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--input-json\fP=""
	Read one strict JSON read request from a file, or - for stdin; cannot be mixed with equivalent read flags or positional read arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--verbose\fP[=false]
	Include short next actions for unsupported or unverified provider features


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail settings show
  icloud --account Personal mail settings show --verbose
  icloud mail settings show --json
.EE


.SH SEE ALSO
\fBicloud-mail-settings(1)\fP
