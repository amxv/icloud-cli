.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-doctor - Diagnose local account configuration and optional live connectivity


.SH SYNOPSIS
\fBicloud doctor [selector] [flags]\fP


.SH DESCRIPTION
Diagnose local account configuration and optional live connectivity


.SH OPTIONS
\fB--all\fP[=false]
	Diagnose every configured account (maximum 100)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for doctor

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--live\fP[=false]
	Resolve credentials and run read-only IMAP/SMTP validation

.PP
\fB--verbose\fP[=false]
	Include bounded protocol capability summaries


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud doctor
  icloud doctor Personal
  icloud doctor --live --json
.EE


.SH SEE ALSO
\fBicloud(1)\fP
