.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-message - Read complete local message content by stable ID


.SH SYNOPSIS
\fBicloud mail message [flags]\fP


.SH DESCRIPTION
Read complete local message content by stable ID


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for message


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail message show msg_…
  icloud mail message raw msg_…
  icloud mail message export msg_… --output message.eml
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-message-export(1)\fP, \fBicloud-mail-message-raw(1)\fP, \fBicloud-mail-message-show(1)\fP
