.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-folders-list - List locally discovered folders without contacting iCloud


.SH SYNOPSIS
\fBicloud mail folders list [flags]\fP


.SH DESCRIPTION
List locally discovered folders without contacting iCloud


.SH OPTIONS
\fB--cursor\fP=""
	Continue from a next_cursor returned by an earlier folder page

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--include-missing\fP[=false]
	Include folders missing from the latest provider discovery

.PP
\fB--input-json\fP=""
	Read one strict JSON read request from a file, or - for stdin; cannot be mixed with equivalent read flags or positional read arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum folders to return (1-100)

.PP
\fB--verbose\fP[=false]
	Include wire names, attributes, UID metadata, and timestamps


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail folders list
  icloud mail folders list --include-missing --verbose
  icloud mail folders list --input-json request.json --json
.EE


.SH SEE ALSO
\fBicloud-mail-folders(1)\fP
