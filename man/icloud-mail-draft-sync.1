.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft-sync - Synchronize provider Drafts and safely upload local revisions


.SH SYNOPSIS
\fBicloud mail draft sync [draft-id] [flags]\fP


.SH DESCRIPTION
Synchronize provider Drafts and safely upload local revisions


.SH OPTIONS
\fB--folder\fP=""
	Explicitly select the provider Drafts mailbox by ID, name, or wire name when iCloud advertises no Drafts role

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--limit\fP=20
	Maximum provider messages committed per Drafts sync page (1-100)

.PP
\fB--verbose\fP[=false]
	Include resulting draft recovery state


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail draft sync
  icloud mail draft sync drf_…
  icloud mail draft sync --folder Drafts
.EE


.SH SEE ALSO
\fBicloud-mail-draft(1)\fP
