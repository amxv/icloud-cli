.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-reply - Reply to one explicitly selected local message


.SH SYNOPSIS
\fBicloud mail reply  [flags]\fP


.SH DESCRIPTION
Reply to one explicitly selected local message


.SH OPTIONS
\fB--attach\fP=[]
	Regular file path to attach; repeat as needed

.PP
\fB--attach-name\fP=[]
	Override one attachment filename as path=filename; repeat as needed

.PP
\fB--attach-type\fP=[]
	Override one attachment media type as path=type/subtype; repeat as needed

.PP
\fB--bcc\fP=[]
	Add a new Bcc envelope recipient; prior Bcc recipients are never inferred

.PP
\fB--body\fP=""
	Inline text body

.PP
\fB--body-file\fP=""
	Text body file path, or - for stdin

.PP
\fB--cc\fP=[]
	Add a Cc recipient; repeat as needed

.PP
\fB--dry-run\fP[=false]
	Preview the resolved reply without creating an attempt or contacting SMTP

.PP
\fB--format\fP=""
	With --dry-run, output text, html, or raw preview content

.PP
\fB--header\fP=[]
	Safe custom header as Name: Value; repeat as needed

.PP
\fB--headers\fP[=false]
	With --dry-run, print normalized headers including RFC threading fields

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for reply

.PP
\fB--html-body\fP=""
	Inline HTML body

.PP
\fB--html-body-file\fP=""
	HTML body file path, or - for stdin

.PP
\fB--idempotency-key\fP=""
	Reuse the original operation when the same normalized request and idempotency key are repeated

.PP
\fB--input-json\fP=""
	Read one strict JSON write request from a file, or - for stdin; cannot be mixed with equivalent write flags or positional write arguments

.PP
\fB--json\fP[=false]
	Emit one stable JSON success envelope

.PP
\fB--replace-cc\fP[=false]
	Replace derived Cc recipients with the addresses supplied by --cc

.PP
\fB--replace-to\fP[=false]
	Replace derived To recipients with the addresses supplied by --to

.PP
\fB--retry-of\fP=""
	Link an explicit retry to one failed or unknown send_… attempt

.PP
\fB--retry-unknown\fP[=false]
	Authorize one duplicate-risk retry of an unknown attempt; requires --retry-of and --yes

.PP
\fB--to\fP=[]
	Add a To recipient; repeat or provide a comma-separated address list

.PP
\fB--verbose\fP[=false]
	With --dry-run, include custom-header detail and HTML byte count

.PP
\fB--yes\fP[=false]
	Confirm an intentional non-interactive reply


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail reply msg_… --body-file reply.txt --dry-run
  icloud mail reply msg_… --body 'Thanks' --idempotency-key reply-01 --yes
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP
