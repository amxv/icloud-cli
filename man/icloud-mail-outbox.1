.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-outbox - Inspect and manually retry sends proven safe before SMTP DATA


.SH SYNOPSIS
\fBicloud mail outbox [flags]\fP


.SH DESCRIPTION
Inspect and manually retry sends proven safe before SMTP DATA


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for outbox


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail outbox list
  icloud mail outbox show out_…
  icloud mail outbox retry out_… --dry-run
  icloud mail outbox retry out_… --yes
  icloud mail outbox cancel out_…
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-outbox-cancel(1)\fP, \fBicloud-mail-outbox-list(1)\fP, \fBicloud-mail-outbox-retry(1)\fP, \fBicloud-mail-outbox-show(1)\fP
