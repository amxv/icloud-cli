.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-draft - Compose, synchronize, inspect, send, and delete iCloud-backed drafts


.SH SYNOPSIS
\fBicloud mail draft [flags]\fP


.SH DESCRIPTION
Compose, synchronize, inspect, send, and delete iCloud-backed drafts


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for draft


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail draft create --to teammate@example.com --subject 'Working note' --body-file draft.txt
  icloud mail draft sync
  icloud mail draft list
  icloud mail draft send drf_… --dry-run
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-draft-create(1)\fP, \fBicloud-mail-draft-delete(1)\fP, \fBicloud-mail-draft-list(1)\fP, \fBicloud-mail-draft-send(1)\fP, \fBicloud-mail-draft-show(1)\fP, \fBicloud-mail-draft-sync(1)\fP, \fBicloud-mail-draft-update(1)\fP
