.nh
.TH "ICLOUD" "1" "Jan 1970" "icloud 0.1.0" "iCloud Mail CLI Manual"

.SH NAME
icloud-mail-identities - Manage local Send From identities for the selected mail account


.SH SYNOPSIS
\fBicloud mail identities [flags]\fP


.SH DESCRIPTION
Manage local Send From identities for the selected mail account


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for identities


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	Select an account by name, email, or stable ID

.PP
\fB--home\fP=""
	Override the iCloud application data directory (otherwise ICLOUD_HOME or the platform default)

.PP
\fB--no-input\fP[=false]
	Never prompt for interactive input

.PP
\fB--request-id\fP=""
	Attach a stable request ID to structured output

.PP
\fB--timeout\fP=30s
	Maximum normal command duration; watch applies it per provider/sync attempt


.SH EXAMPLE
.EX
  icloud mail identities list
  icloud mail identities add --address alias@icloud.com --kind icloud_alias
  icloud mail identities default mid_…
.EE


.SH SEE ALSO
\fBicloud-mail(1)\fP, \fBicloud-mail-identities-add(1)\fP, \fBicloud-mail-identities-default(1)\fP, \fBicloud-mail-identities-disable(1)\fP, \fBicloud-mail-identities-enable(1)\fP, \fBicloud-mail-identities-list(1)\fP, \fBicloud-mail-identities-remove(1)\fP, \fBicloud-mail-identities-show(1)\fP, \fBicloud-mail-identities-update(1)\fP
