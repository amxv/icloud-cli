{
  "name": "@amxv/icloud-cli",
  "version": "0.1.0",
  "description": "A command-line interface for iCloud, starting with a comprehensive iCloud Mail client",
  "license": "Apache-2.0",
  "author": "amxv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amxv/icloud-cli.git",
    "directory": "npm"
  },
  "homepage": "https://icloud.ashray.xyz",
  "bugs": {
    "url": "https://github.com/amxv/icloud-cli/issues"
  },
  "bin": {
    "icloud": "bin/icloud.js"
  },
  "man": [
    "man/icloud.1"
  ],
  "config": {
    "cliName": "icloud",
    "cliBinaryName": "icloud",
    "goModule": "github.com/amxv/icloud-cli"
  },
  "files": [
    "bin/icloud.js",
    "scripts/postinstall.js",
    "cmd",
    "internal",
    "schemas",
    "man",
    "completions",
    "go.mod",
    "go.sum",
    "README.md",
    "LICENSE",
    "project.config.json"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --check bin/icloud.js && node --check scripts/postinstall.js && node --test scripts/prepare-package.test.mjs",
    "lint": "npm run test",
    "prepare:package": "node scripts/prepare-package.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "icloud",
    "apple",
    "mail",
    "email",
    "imap",
    "smtp",
    "automation"
  ]
}
